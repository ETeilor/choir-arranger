+    BOOL receivePromisedFiles (bool (ComponentPeer::* callback) (const DragInfo&), id <NSDraggingInfo>,
+                               NSPasteboard* pasteboard, ComponentPeer::DragInfo dragInfo)
+    {
+        if (callback != &ComponentPeer::handleDragDrop)
+        {
+            dragInfo.files.add ("promised-file.mid");
+            return (this->*callback) (dragInfo);
+        }
+
+        NSArray* receivers = [pasteboard readObjectsForClasses: @[[NSFilePromiseReceiver class]] options: nil];
+
+        if (receivers == nil || [receivers count] == 0)
+            return false;
+
+        const auto dir = File::getSpecialLocation (File::tempDirectory)
+                             .getChildFile ("JuceDroppedPromises")
+                             .getChildFile (String (Time::currentTimeMillis()));
+        dir.createDirectory();
+        NSURL* dest = [NSURL fileURLWithPath: juceStringToNS (dir.getFullPathName()) isDirectory: YES];
+
+        static NSOperationQueue* queue = [[NSOperationQueue alloc] init];
+        WeakReference<Component> target (&component);
+        const auto position = dragInfo.position;
+
+        for (NSFilePromiseReceiver* receiver in receivers)
+        {
+            [receiver receivePromisedFilesAtDestination: dest
+                                                options: @{}
+                                         operationQueue: queue
+                                                 reader: ^(NSURL* fileURL, NSError* error)
+            {
+                if (error != nil || fileURL == nil)
+                    return;
+
+                const auto path = nsStringToJuce ([fileURL path]);
+
+                MessageManager::callAsync ([target, path, position]
+                {
+                    if (auto* c = target.get())
+                        if (auto* peer = c->getPeer())
+                        {
+                            ComponentPeer::DragInfo info;
+                            info.position = position;
+                            info.files.add (path);
+                            peer->handleDragDrop (info);
+                        }
+                });
+            }];
+        }
+
+        return true;
+    }
